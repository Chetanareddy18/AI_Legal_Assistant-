# Copy this file to `.env` and fill in the values you need.
# Only WATSONX_* are required for LLM-generated answers; everything else has
# safe defaults so the app runs fully offline with the FAISS backend.

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
API_KEY=
ALLOWED_ORIGINS=*
RATE_LIMIT=60/minute

# --- Vector store backend: "faiss" (local, default) or "pinecone" (cloud) ---
VECTOR_BACKEND=faiss
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
FAISS_INDEX_DIR=embeddings/faiss_index

PINECONE_API_KEY=
PINECONE_INDEX_NAME=legal-assistant-index

# --- IBM WatsonX (required for LLM-generated answers) ---
WATSONX_API_KEY=
WATSONX_URL=
WATSONX_PROJECT_ID=
WATSONX_MODEL_ID=mistralai/mistral-medium-2505

# --- IBM Watson NLU (optional; used by preprocess_nlu.py) ---
IBM_NLU_API_KEY=
IBM_NLU_URL=

# --- Agentic system ---
MAX_PLAN_STEPS=6
MAX_REASONING_HOPS=3
AGENT_TOP_K=4

# --- Multi-modal ---
CLIP_MODEL_NAME=clip-ViT-B-32
ENABLE_MULTIMODAL=true
